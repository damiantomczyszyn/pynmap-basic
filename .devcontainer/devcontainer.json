{
  "name": "pynmap-basic",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true
    }
  },

  "// uwaga": [
    "NET_ADMIN + NET_RAW sa potrzebne do -sS (surowe sockety).",
    "Bez nich dziala tylko -sT. Codespaces honoruje te uprawnienia,",
    "bo kontener dostaje wlasna przestrzen sieciowa."
  ],
  "runArgs": [
    "--cap-add=NET_ADMIN",
    "--cap-add=NET_RAW"
  ],

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff",
        "ms-vscode.cpptools",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "editor.rulers": [100],
        "files.trimTrailingWhitespace": true
      }
    }
  },

  "remoteUser": "vscode"
}
